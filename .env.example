# If absent here, DeepSeek settings may be read from ../PuwuQuiz/.env.
# Process environment > project .env > reference .env > defaults.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=8
# Realtime short decisions: request non-thinking mode explicitly.
DEEPSEEK_THINKING=disabled
# DeepSeek always connects directly; HTTP(S)_PROXY/ALL_PROXY/DEEPSEEK_PROXY are ignored.

# Jev: process environment > project .env; never reuse DeepSeek credentials.
TYPESAFE_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=8
# Jev uses this explicit proxy, independently of the process HTTP(S)_PROXY.
# Local HTTP or mixed proxy; SOCKS requires httpx[socks].
JEV_PROXY=http://127.0.0.1:7890
